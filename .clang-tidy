---
# The noexcept-* checks (and their cppcoreguidelines aliases) are disabled because
# clang-tidy 18 overflows the stack in ExceptionSpecAnalyzer on nlohmann/json headers.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-noexcept-*,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  misc-*,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  -performance-noexcept-*,
  portability-*,
  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers
WarningsAsErrors: ''
HeaderFilterRegex: '.*/gateway/(src|include|tests)/.*'
FormatStyle: file
CheckOptions:
  - key: readability-function-cognitive-complexity.Threshold
    value: '25'
  - key: misc-const-correctness.AnalyzeValues
    value: 'true'
...
